NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Only local bootstrap/migrations use these. Never put them in NEXT_PUBLIC variables.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
DEMO_PASSWORD=
DEMO_PROJECT_REF=your-project
# Set only when resetting the dedicated AIRMECH demo tenant.
DEMO_RESET_CONFIRM=
# Optional; otherwise VERCEL_URL or the current request origin is used.
APP_URL=
