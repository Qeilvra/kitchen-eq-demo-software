{
  "name": "airmech-one",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "test:finance": "tsx --test tests/finance-closeout.test.ts tests/finance.database.test.ts",
    "test:finance:live": "tsx --env-file=.env.local scripts/verify-finance-live.ts",
    "test:finance:browser": "playwright test e2e/finance.spec.ts --workers=1 --output=artifacts/finance-closeout/browser-tests",
    "test:finance:performance": "tsx --env-file=.env.local scripts/verify-finance-performance.ts",
    "db:verify-finance": "tsx --env-file=.env.local scripts/verify-finance-schema.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:seed-finance": "tsx --env-file=.env.local scripts/finance-demo.ts",
    "db:align-demo": "tsx --env-file=.env.local scripts/align-demo.ts",
    "db:reset-demo": "tsx --env-file=.env.local scripts/seed.ts --reset",
    "test:live": "tsx --env-file=.env.local scripts/verify-live.ts"
  },
  "dependencies": {
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^9.39.1",
    "eslint-config-next": "latest",
    "pg": "latest",
    "prettier": "latest",
    "tsx": "latest",
    "typescript": "^5.9.3"
  }
}
